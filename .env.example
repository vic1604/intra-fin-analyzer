# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env.
# Só é necessário para os modos --mode llm / ask / smoke-llm. O modo padrão (reference) roda sem chave.

# Provedor: anthropic | openai | azure_openai | ollama | gemini | openai_compatible
#   ollama            -> modelo open source LOCAL, sem conta e SEM chave (veja README: "Rodar sem chave paga")
#   gemini            -> chave gratuita do Google AI Studio (GEMINI_API_KEY)
#   openai_compatible -> qualquer API compatível com /chat/completions (LLM_BASE_URL + LLM_API_KEY)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Limite de tokens de SAÍDA por chamada. Modelos que 'pensam' (ex.: Gemini 3.x) gastam parte dele raciocinando: use 16384 ou mais.
LLM_MAX_TOKENS=16384

# --- Sem chave paga ---
# Ollama local (instale o Ollama e rode `ollama pull <modelo>`): LLM_PROVIDER=ollama, LLM_MODEL=<nome do modelo baixado>
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=32768
LLM_TIMEOUT=1800
# Tentativas em erros temporários (429/503/rede), com espera crescente de 2 a 45 s entre elas
LLM_RETRIES=7
# Cache em disco das respostas do modelo (data/cache/llm): retoma execuções interrompidas e evita gastar cota repetida. LLM_CACHE=0 desliga (para medir tempo/custo do zero).
LLM_CACHE=1
# Gemini / outras APIs compatíveis:
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure OpenAI (LLM_MODEL = nome do *deployment*)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Preços em US$ por 1M de tokens — usados só para ESTIMAR custo. Conferir na página do provedor.
# Exemplo (gemini-3.5-flash-lite, preço de tabela): 0.30 / 2.50. No plano GRATUITO o custo real é US$ 0.
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0

# Quantas páginas por consulta o BM25 devolve na seleção de contexto
TOP_K_PAGES=6
# Teto de páginas enviadas por chamada (reduza em modelos locais pequenos para caber no contexto)
MAX_PAGES=18

# --- Observabilidade ---
# Nível dos logs no terminal (DEBUG|INFO|WARNING). O JSONL completo vai para outputs/logs/run.jsonl.
LOG_LEVEL=WARNING

# --- Saída ---
# Pasta dos resultados (padrão: outputs). Ex.: OUTPUT_DIR=outputs_llm para não sobrescrever a execução em modo reference.
OUTPUT_DIR=
